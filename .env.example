# Copy to .env and adjust for your device. Source it before running the helpers:
#   set -a; . ./.env; set +a

CHROOT_DIR=/path/to/chroot          # e.g. /your/chroot/path
TERMUX_HOME=/data/data/com.termux/files/home
TERMUX_PREFIX=/data/data/com.termux/files/usr   # Termux $PREFIX (for resolv.conf)
# Utgard LPE research (optional — see utgard/run.sh; firmware-specific, do NOT guess)
# SLOT_PHYS=1ee77a0          # physical address of sys_call_table[244]
# KLN_ADDR=ffffffc00111e5d0  # address of kallsyms_lookup_name
# GW=/data/local/tmp/gpwrite64
# KF=/data/local/tmp/kfunc_new
